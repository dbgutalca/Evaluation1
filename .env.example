# ==============================================================================
# Environment Configuration for Database Tests & Benchmarks
# Copy this file to '.env' and adjust the values for your server:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Settings
PG_URL=jdbc:postgresql://localhost:5432/postgres
PG_USER=postgres
PG_PASS=postgres

# Neo4j Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=password
